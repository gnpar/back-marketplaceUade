#
# Archivo de referencia de solicitudes al servicio desarrollado.
# Para pruebas rápidas
#
# Las rutas protegidas piden el JWT en el header Authorization. Ejecutar primero
# "Registro" y "Login": el login guarda el token en la variable {{token}} y el
# resto de las llamadas lo reutilizan.
#

### Registro de un usuario

POST http://localhost:8080/api/usuarios/registro
Content-Type: application/json

{
  "nombreUsuario": "ana123",
  "mail": "ana@test.com",
  "contrasena": "Clave1234",
  "nombre": "Ana",
  "apellido": "Gomez",
  "fechaNacimiento": "1998-03-15",
  "sexo": "FEMENINO"
}

### Login (guarda el token para las llamadas siguientes)

POST http://localhost:8080/api/usuarios/login
Content-Type: application/json

{
  "mail": "ana@test.com",
  "contrasena": "Clave1234"
}

> {%
  client.global.set("token", response.body.token);
  client.log(`token: ${response.body.token}`);
%}

### Crear un producto (requiere autenticacion)

POST http://localhost:8080/api/productos
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Notebook Dell",
  "descripcion": "Notebook Dell Inspiron 15 pulgadas",
  "precio": 899999.99,
  "categoriaId": 1
}

### Obtener todos los productos

GET http://localhost:8080/api/productos
Accept: application/json

### Obtener productos de un vendedor

GET http://localhost:8080/api/productos?usuarioId=1
Accept: application/json

### Obtener producto por ID

GET http://localhost:8080/api/productos/1
Accept: application/json

### Actualizar un producto (requiere autenticacion y ser el vendedor)

PUT http://localhost:8080/api/productos/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Notebook Dell XPS",
  "descripcion": "Notebook Dell XPS 13 pulgadas",
  "precio": 1099999.99,
  "categoriaId": 1
}

### Eliminar un producto (requiere autenticacion y ser el vendedor)

DELETE http://localhost:8080/api/productos/1
Authorization: Bearer {{token}}

### Ver el carrito (requiere autenticacion)

GET http://localhost:8080/api/carrito
Accept: application/json
Authorization: Bearer {{token}}

### Crear una categoria (requiere rol ADMIN)
# Para probarlo hay que promover al usuario en la base:
#   UPDATE usuarios SET rol = 'ADMIN' WHERE mail = 'ana@test.com';
# No hace falta volver a loguearse: el rol se lee de la base al validar el token.

POST http://localhost:8080/api/categorias
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Informática"
}

### Ruta protegida sin token: devuelve 401

GET http://localhost:8080/api/carrito
Accept: application/json

### Obtener la lista de endpoints (Actuator)

GET http://localhost:8080/actuator/mappings
Accept: application/json

> {%
  const data = response.body;
  const contexts = Object.keys(data.contexts || {});
  for (const ctx of contexts) {
    const dispatchers = data.contexts[ctx]?.mappings?.dispatcherServlets?.dispatcherServlet || [];
    for (const d of dispatchers) {
      if (d.predicate && !d.predicate.startsWith('/actuator')) {
        client.log(`  ${d.predicate}  [${d.details?.requestMappingConditions?.methodsCondition?.value || '?'}]  →  ${d.handler}`);
      }
    }
  }
%}